@startuml
title RPG Character Creator - Use Cases

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Guest" as Guest
actor "Authenticated User" as User
actor "Supabase Auth" as Auth

rectangle "RPG Character Creator" {
    usecase "View Welcome Screen" as Welcome
    usecase "Register Account" as Register
    usecase "Confirm Email" as Confirm
    usecase "Sign In" as Login
    usecase "Recover Password" as Recover
    usecase "Sign Out" as Logout
    usecase "Manage Account Settings" as Settings

    usecase "Create Character" as Create
    usecase "Choose Class & Attributes" as Choose
    usecase "Randomize Draft" as Randomize
    usecase "Save Character" as Save
    usecase "View My Character" as View
    usecase "Edit Character" as Edit
    usecase "Export Retro PDF" as Export
    usecase "Delete Character" as Delete
    usecase "Switch Theme" as Theme
}

Guest --> Welcome
Guest --> Register
Guest --> Login
Guest --> Recover
Guest --> Confirm
Guest --> Theme

User --> Logout
User --> Settings
User --> Create
User --> View
User --> Edit
User --> Export
User --> Delete
User --> Theme

Create .> Choose : <<include>>
Create .> Save : <<include>>
Edit .> Choose : <<include>>
Edit .> Save : <<include>>
Randomize .> Choose : <<extend>>
User --> Randomize

Auth -- Register
Auth -- Confirm
Auth -- Login
Auth -- Recover
Auth -- Logout

note right of Create
  One character per user;
  no gender or sex field.
end note

@enduml